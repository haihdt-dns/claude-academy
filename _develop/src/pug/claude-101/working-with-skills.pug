extends ../utils/_lesson.pug

block append meta
  -
    var courseId = 'claude-101'
    var currentSlug = 'working-with-skills'
    var lessonData = JSON.parse(nodeFs.readFileSync(nodePath.join(process.cwd(), '../data/claude-101/working-with-skills.json'), 'utf8'))
    title = lessonData.titleEn + ' · Claude 101 · Claude Academy'
    description = 'Learn how Claude Skills work — from built-in document creation to custom repeatable workflows — and how they differ from Projects.'
    baseURL = 'https://chobadon.com/claude-academy/'
    ogImageURL = baseURL + 'assets/images/ogp.png'
    canonicalURL = `${baseURL}${courseId}/${currentSlug}/`

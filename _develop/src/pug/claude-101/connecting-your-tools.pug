extends ../utils/_lesson.pug

block append meta
  -
    var courseId = 'claude-101'
    var currentSlug = 'connecting-your-tools'
    var lessonData = JSON.parse(nodeFs.readFileSync(nodePath.join(process.cwd(), '../data/claude-101/connecting-your-tools.json'), 'utf8'))
    title = lessonData.titleEn + ' · Claude 101 · Claude Academy'
    description = 'Learn how connectors transform Claude into an informed collaborator by linking it to the tools, data, and services you use every day.'
    baseURL = 'https://chobadon.com/claude-academy/'
    ogImageURL = baseURL + 'assets/images/ogp.png'
    canonicalURL = `${baseURL}${courseId}/${currentSlug}/`


include ./_util
include ./_mixins



block meta
  -
    var title = 'サンプル';
    var description = '';
    var keywords = '';
    var baseURL  = 'http://sample.com/';
    var ogImageURL  = `${url}ogp.png`;
    var noIndex = true;
    var canonicalURL = baseURL;


block page
  - var pageTitle = ''

-
  if (pageTitle.length) {
    pageTitle = pageTitle + ' | ';
  }
  ErrorCheck();

block vars
  -
    var pageClass = '';


  


doctype html
html(lang='ja')
  head
    if isSSI
      != `\n\n    <!--#include virtual="${ assetPath }include/ga_head.html" -->\n`
    else
      include ../assets/include/ga_head.pug
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1, shrink-to-fit=no')

    title #{pageTitle}#{title}

    meta(http-equiv='x-ua-compatible' content='ie=edge')
    meta(name="format-detection", content="telephone=no")
    meta(name='description', content=description)
    //- meta(name="keywords", content=keywords)
    
    meta(property='og:type', content='website')
    meta(property='og:description', content=description)
    meta(property='og:title', content=pageTitle+title)
    meta(property='og:url', content=canonicalURL)
    meta(property='og:image', content=ogImageURL)
    meta(property='og:locale', content='ja_JP')

    meta(name='twitter:card', content='summary')
    meta(name='twitter:description', content=description)
     //- meta(name='twitter:site', content="@*****") *公式user名がある場合 https://developer.twitter.com/ja/docs/tweets/optimize-with-cards/guides/getting-started

    if !noIndex  
      link(rel='canonical', href=canonicalURL)
      
    block stylesheet
      link(rel="preconnect", href="https://fonts.googleapis.com")
      link(rel="preconnect", href="https://fonts.gstatic.com" crossorigin)
      link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap")
      link(rel="stylesheet", href=assetPath + 'css/common.css')
      link(rel='shortcut icon', href='/favicon.ico')

    if noIndex
      meta(name="robots" content="noindex, nofollow, nosnippet, noarchive, noimageindex, notranslate")
      meta(name="googlebot" content="noindex, nofollow, nosnippet, noarchive, noimageindex")
      meta(name="bingbot" content="noindex, nofollow, nosnippet, noarchive, noimageindex")
      - console.log('\033[43m【Check :  No Index】\033[0m  : ' + filename);

    //- meta(name='twitter:site', content="@*****") *公式user名がある場合 https://developer.twitter.com/ja/docs/tweets/optimize-with-cards/guides/getting-started

    block ld
      +breadcrumbList([])
  body
    if isSSI
      != `\n\n    <!--#include virtual="${ assetPath }include/ga_body.html" -->\n`
    else
      include ../assets/include/ga_body.pug
      
    #root.root(class=pageClass)
      //-
        isSSI = trueの時SSI, そうでない時pugでコーディング
        watch中に、static_files/include/header.htmlとかを作成すればpublic_htmlにコピーされる。
      if isSSI
        != `\n\n    <!--#include virtual="${ assetPath }include/header.html" -->\n`
      else
        include ../assets/include/header.pug

      main.main#main
        block main

      //-  SSIのfooter版。サーバーで使えるか使えないかで分けると良い。
      if isSSI
        != `\n\n    <!--#include virtual="${ assetPath }include/footer.html" -->\n`
      else
        include ../assets/include/footer.pug

    block script
      script(src=assetPath + 'js/main.js', type="module", crossorigin)
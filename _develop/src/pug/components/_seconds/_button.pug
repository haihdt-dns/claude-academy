section(style="margin: 30px 0 50px;")
  .row
    h2(style="margin-bottom: 20px; padding-bottom: 15px; border-bottom: 2px solid #000;")
      | Module button in site
    article(style="margin-bottom: 40px;")
      h3(style="margin-bottom: 30px; padding-bottom: 10px; border-bottom: 1px solid #000;") .btn
      ul(style="display: flex; justify-content:flex-start; flex-wrap: wrap; align-items:center; margin:-15px 0 0 -15px; width: calc(100% + 10px)")
        li(style="margin: 15px")
          a.btn(href="#anchor") Text button dummy
        li#test(style="margin: 10px;")
          button.btn Text button dummy
    article(style="margin-bottom: 40px;")

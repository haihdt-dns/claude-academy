extends ../../utils/_base.pug

block append meta
  -
    description = '';
    canonicalURL = `${baseURL}second/form`;


block append page
  - var pageTitle = 'お問い合わせ'

block append vars
  - var pageClass ='page-contact'


block append stylesheet
  link(rel="stylesheet", href=assetPath + 'css/contact.css')

block main
  include ./_mixin
  -
    var breadcrumbList = [
      {
        name: 'お問い合わせ',
      }
    ];
  .main__inner
    +mv('お問い合わせ', 'CONTACT')
    +breadcrumb(breadcrumbList)

extends ../utils/_lesson.pug

block append meta
  -
    var courseId = 'claude-with-the-anthropic-api'
    var currentSlug = 'welcome-to-the-course'
    var lessonData = JSON.parse(nodeFs.readFileSync(nodePath.join(process.cwd(), '../data/claude-with-the-anthropic-api/welcome-to-the-course.json'), 'utf8'))
    title = lessonData.titleEn + ' · Claude with the Anthropic API · Claude Academy'
    description = 'An introduction to the Claude with the Anthropic API course — what you\'ll learn, prerequisites, and who this course is for.'
    baseURL = 'https://chobadon.com/claude-academy/'
    ogImageURL = baseURL + 'assets/images/ogp.png'
    canonicalURL = `${baseURL}${courseId}/${currentSlug}/`

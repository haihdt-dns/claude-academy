extends ../utils/_lesson.pug

block append meta
  -
    var courseId = 'ai-fluency'
    var currentSlug = 'certificate-of-completion'
    var lessonData = JSON.parse(nodeFs.readFileSync(nodePath.join(process.cwd(), '../data/ai-fluency/certificate-of-completion.json'), 'utf8'))
    title = lessonData.titleEn + ' · AI Fluency · Claude Academy'
    description = 'Complete the final quiz to earn your AI Fluency: Framework and Foundations Certificate of Completion and share it on LinkedIn or with your team.'
    baseURL = 'https://chobadon.com/claude-academy/'
    ogImageURL = baseURL + 'assets/images/ogp.png'
    canonicalURL = `${baseURL}${courseId}/${currentSlug}/`

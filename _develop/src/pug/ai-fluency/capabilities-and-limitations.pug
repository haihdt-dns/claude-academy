extends ../utils/_lesson.pug

block append meta
  -
    var courseId = 'ai-fluency'
    var currentSlug = 'capabilities-and-limitations'
    var lessonData = JSON.parse(nodeFs.readFileSync(nodePath.join(process.cwd(), '../data/ai-fluency/capabilities-and-limitations.json'), 'utf8'))
    title = lessonData.titleEn + ' · AI Fluency · Claude Academy'
    description = 'Explore what generative AI can and cannot do — including hallucinations, knowledge cutoffs, context windows, and where human-AI collaboration works best.'
    baseURL = 'https://chobadon.com/claude-academy/'
    ogImageURL = baseURL + 'assets/images/ogp.png'
    canonicalURL = `${baseURL}${courseId}/${currentSlug}/`

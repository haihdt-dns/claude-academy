extends ../utils/_lesson.pug

block append meta
  -
    var courseId = 'ai-fluency'
    var currentSlug = 'introduction-to-ai-fluency'
    var lessonData = JSON.parse(nodeFs.readFileSync(nodePath.join(process.cwd(), '../data/ai-fluency/introduction-to-ai-fluency.json'), 'utf8'))
    title = lessonData.titleEn + ' · AI Fluency · Claude Academy'
    description = 'Learn the four core competencies of AI Fluency: Delegation, Description, Discernment, and Diligence.'
    baseURL = 'https://chobadon.com/claude-academy/'
    ogImageURL = baseURL + 'assets/images/ogp.png'
    canonicalURL = `${baseURL}${courseId}/${currentSlug}/`
